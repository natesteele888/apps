// Firestore rules for the nates-toolbox Firebase project (Toolbox, Gameday Picks, Read 20, Photo Blueprint).
// Copy of the live rules from the Firebase console, saved 2026-11-06.
// OWNER_EMAIL stands in for Nate's sign-in email (this repo is public, so the
// real address is not committed). Put the real address back before pasting
// this into the console. Test: cd toolbox && npm install && npm test
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'OWNER_EMAIL' && request.auth.token.email_verified == true;
    }
    // ---------- App icons: public so every app and the App Store can show them ----------
    match /public_icons/{id} {
      allow read: if true;
    }
    // ---------- Store listings: public so the App Store sync can read them ----------
    match /public_listings/{id} {
      allow read: if true;
    }
    // ---------- Gameday Picks (apps/picks) ----------
    function gpOwner() {
      return request.auth != null && request.auth.token.email == "OWNER_EMAIL"
        && request.auth.token.email_verified == true;
    }
    function gpPlayer() {
      return request.auth != null && exists(/databases/$(database)/documents/gp_players/$(request.auth.uid));
    }
    function gpName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 24; }
    match /gp_codes/{code} {
      allow read, write: if gpOwner();
    }
    match /gp_players/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow read: if gpPlayer() || gpOwner();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'code', 'joinedAt'])
        && gpName(request.resource.data) && request.resource.data.code is string
        && ((request.resource.data.code == "OWNER" && gpOwner())
            || (request.resource.data.code != "OWNER"
                && exists(/databases/$(database)/documents/gp_codes/$(request.resource.data.code))
                && get(/databases/$(database)/documents/gp_codes/$(request.resource.data.code)).data.active == true));
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && gpName(request.resource.data);
      allow delete: if gpOwner();
    }
    match /gp_picks/{id} {
      allow read: if gpPlayer();
      allow create, update: if gpPlayer() && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + "_" + request.resource.data.week
        && request.resource.data.picks is map && request.resource.data.picks.size() <= 40;
      allow delete: if gpOwner();
    }
    // ---------- Read 20 (apps/read20): optional cloud backup of one reader's log ----------
    // One document per signed-in Google account, readable and writable only by that account.
    // The log is one JSON string (roughly 150 KB for a year of nightly reading, so the limit is 900 KB).
    match /r20_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['log', 'updated'])
        && request.resource.data.log is string && request.resource.data.log.size() <= 900000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // ---------- Photo Blueprint (apps/photoblueprint): photos pinned to where they were shot ----------
    // sp_sheets: one photographer's own sheets (owner only, their cross-phone copy).
    // sp_public: the sheets shared with everyone (anyone can read; only the owner writes, and the doc's uid must be theirs).
    // sp_images: the resized picture for a sheet, as one data-URL string under 950 KB; readable when the sheet is public or by its owner.
    function spOwnerOf(d) { return request.auth != null && d.uid == request.auth.uid; }
    function spSheetOk(d) {
      return d.keys().hasOnly(['id', 'uid', 'author', 'public', 'created', 'updated', 'title', 'story', 'lat', 'lon', 'heading', 'posture', 'height',
          'camera', 'lens', 'focal', 'sensor', 'aperture', 'shutter', 'iso', 'ev', 'filters', 'support', 'light', 'taken', 'ig', 'thumb', 'w', 'h', 'place', 'distance'])
        && d.uid is string && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.public is bool && d.created is number && d.updated is number
        && (!('story' in d) || (d.story is string && d.story.size() <= 6000))
        && (!('thumb' in d) || (d.thumb is string && d.thumb.size() <= 70000))
        && (!('author' in d) || (d.author is string && d.author.size() <= 80))
        && (!('ig' in d) || (d.ig is string && d.ig.size() <= 300))
        && d.lat is number && d.lon is number && d.lat >= -90 && d.lat <= 90 && d.lon >= -180 && d.lon <= 180;
    }
    match /sp_sheets/{id} {
      allow read: if spOwnerOf(resource.data);
      allow create: if spOwnerOf(request.resource.data) && request.resource.data.id == id && spSheetOk(request.resource.data);
      allow update: if spOwnerOf(resource.data) && spOwnerOf(request.resource.data) && request.resource.data.id == id && spSheetOk(request.resource.data);
      allow delete: if spOwnerOf(resource.data);
    }
    match /sp_public/{id} {
      allow read: if true;
      allow create: if spOwnerOf(request.resource.data) && request.resource.data.id == id && request.resource.data.public == true && spSheetOk(request.resource.data);
      allow update: if spOwnerOf(resource.data) && spOwnerOf(request.resource.data) && request.resource.data.id == id && request.resource.data.public == true && spSheetOk(request.resource.data);
      allow delete: if spOwnerOf(resource.data);
    }
    match /sp_images/{id} {
      allow read: if resource.data.public == true || spOwnerOf(resource.data);
      allow create, update: if spOwnerOf(request.resource.data) && (resource == null || spOwnerOf(resource.data))
        && request.resource.data.keys().hasOnly(['uid', 'public', 'data', 'updated'])
        && request.resource.data.public is bool
        && (!('data' in request.resource.data) || (request.resource.data.data is string && request.resource.data.data.size() <= 950000));
      allow delete: if spOwnerOf(resource.data);
    }
    // ---------- Get Ready (apps/getready): optional cloud backup of one person's checklist ----------
    // One document per signed-in Google account, readable and writable only by that account: the lists,
    // check marks and streak history as one JSON string, plus the ids of items that have a picture.
    // Pictures (small JPEGs as text) sit one per item under photos/.
    match /gr_users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updated', 'pids'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 400000
        && (!('pids' in request.resource.data) || (request.resource.data.pids is list && request.resource.data.pids.size() <= 200));
      match /photos/{pid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['img', 'updated'])
          && request.resource.data.img is string && request.resource.data.img.size() <= 600000;
      }
    }
    // ---------- Read 20 family link: one shared log for two homes ----------
    // The document id is a long random code that only people given the family link know. Any Google sign-in can
    // get, create or update the one document it knows the id of; nobody can list them, and nothing can be deleted
    // (erasing writes an empty log). Anonymous sessions are excluded.
    match /r20_shared/{key} {
      allow get: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && key.matches('[a-z2-7]{20}');
      allow create, update: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && key.matches('[a-z2-7]{20}')
        && request.resource.data.keys().hasOnly(['log', 'updated'])
        && request.resource.data.log is string && request.resource.data.log.size() <= 900000;
    }
    match /gp_weeks/{key} {
      allow read, write: if gpPlayer();
    }
    // ---------- App numbers: anonymous counts sent by install.js (read on toolbox/numbers.html) ----------
    // One document per phone per app (installs) or per phone per app per week (opens). The id is
    // app~phone or app~week~phone, and a phone is a random 16-character code: no names, accounts or content.
    // Anyone may create one; only the owner (the rule at the top) can read, change or delete them.
    function countOk(id, n) {
      return request.resource.data.keys().hasOnly(['app', 'week'])
        && request.resource.data.app is string && request.resource.data.app.matches('[A-Za-z0-9-]{1,60}')
        && request.resource.data.week is string && request.resource.data.week.matches('20[0-9]{2}-W[0-9]{2}')
        && id.split('~').size() == n && id.split('~')[0] == request.resource.data.app
        && id.split('~')[n - 1].matches('[a-z0-9]{16}');
    }
    match /app_installs/{id} {
      allow create: if countOk(id, 2);
    }
    match /app_opens/{id} {
      allow create: if countOk(id, 3) && id.split('~')[1] == request.resource.data.week;
    }
  }
}
