// Firestore rules for the nates-toolbox Firebase project (Toolbox, Gameday Picks, Read 20, Photo Blueprint, Get Ready, Catch Log).
// Copy of the live rules from the Firebase console, saved 2026-11-06. Photo Blueprint section changed 2026-11-15
// (shared sheets lose the name and exact pin), published 2026-11-16. app_me added 2026-11-16 ("this is me" for app numbers),
// published 2026-11-16. Fairway (golf_events) added 2026-11-17 and not yet published; the watch link (fw_links,
// fw_pair) and the watch's Gameday Picks access (gp_watch, plus the watch lines in gp_picks) added 2026-11-17 and not yet
// published; everything else in the live console rules matches this file.
// OWNER_EMAIL stands in for Nate's sign-in email (this repo is public, so the
// real address is not committed). Put the real address back before pasting
// this into the console. Test: cd toolbox && npm install && npm test
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'OWNER_EMAIL' && request.auth.token.email_verified == true;
    }
    // ---------- App icons: public so every app and the App Store can show them ----------
    match /public_icons/{id} {
      allow read: if true;
    }
    // ---------- Store listings: public so the App Store sync can read them ----------
    match /public_listings/{id} {
      allow read: if true;
    }
    // ---------- Gameday Picks (apps/picks) ----------
    function gpOwner() {
      return request.auth != null && request.auth.token.email == "OWNER_EMAIL"
        && request.auth.token.email_verified == true;
    }
    function gpPlayer() {
      return request.auth != null && exists(/databases/$(database)/documents/gp_players/$(request.auth.uid));
    }
    function gpName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 24; }
    match /gp_codes/{code} {
      allow read, write: if gpOwner();
    }
    match /gp_players/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow read: if gpPlayer() || gpOwner();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'code', 'joinedAt'])
        && gpName(request.resource.data) && request.resource.data.code is string
        && ((request.resource.data.code == "OWNER" && gpOwner())
            || (request.resource.data.code != "OWNER"
                && exists(/databases/$(database)/documents/gp_codes/$(request.resource.data.code))
                && get(/databases/$(database)/documents/gp_codes/$(request.resource.data.code)).data.active == true));
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && gpName(request.resource.data);
      allow delete: if gpOwner();
    }
    // A Wear OS watch (the family watch app) makes NFL picks for one player. The watch signs in anonymously; the player's
    // phone, signed in as that player, okays it in gp_watch/<the watch's id>. The watch may then read and save that one
    // player's own picks documents, and nothing else in Gameday Picks.
    function gpWatchFor() { return get(/databases/$(database)/documents/gp_watch/$(request.auth.uid)).data.uid; }
    function gpWatch() {
      return request.auth != null && exists(/databases/$(database)/documents/gp_watch/$(request.auth.uid))
        && exists(/databases/$(database)/documents/gp_players/$(gpWatchFor()));
    }
    match /gp_watch/{wuid} {
      allow get: if request.auth != null && (request.auth.uid == wuid || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if gpPlayer() && wuid.matches('[A-Za-z0-9]{10,128}') && wuid != request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == request.auth.uid
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      allow update: if gpPlayer() && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == request.auth.uid
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || gpOwner());
    }
    match /gp_picks/{id} {
      allow get: if gpWatch() && id.matches(gpWatchFor() + '_[0-9]{4}-[0-9]+-[0-9]+');
      allow create, update: if gpWatch() && request.resource.data.uid == gpWatchFor()
        && id == gpWatchFor() + "_" + request.resource.data.week && request.resource.data.week.matches('[0-9]{4}-[0-9]+-[0-9]+')
        && request.resource.data.keys().hasOnly(['uid', 'week', 'picks', 'updatedAt'])
        && request.resource.data.picks is map && request.resource.data.picks.size() <= 40;
      allow read: if gpPlayer();
      allow create, update: if gpPlayer() && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + "_" + request.resource.data.week
        && request.resource.data.picks is map && request.resource.data.picks.size() <= 40;
      allow delete: if gpOwner();
    }
    // ---------- Read 20 (apps/read20): optional cloud backup of one reader's log ----------
    // One document per signed-in Google account, readable and writable only by that account.
    // The log is one JSON string (roughly 150 KB for a year of nightly reading, so the limit is 900 KB).
    match /r20_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['log', 'updated'])
        && request.resource.data.log is string && request.resource.data.log.size() <= 900000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // ---------- Photo Blueprint (apps/photoblueprint): photos pinned to where they were shot ----------
    // sp_sheets: one photographer's own sheets (owner only, their cross-phone copy: exact pin, place and name).
    // sp_feed: the sheets shared with everyone. Anyone can read them, so they hold no name (author) and no typed place, and the
    //   pin is rounded to a tenth of a degree (the town, not the spot). Only the owner writes, and the doc's uid must be theirs.
    // sp_public: the old shared copy, which held the name and exact pin. Now readable only by its owner and never written
    //   again; the app moves each one to sp_feed when its owner signs in (Photo Blueprint 1.3.0).
    // sp_images: the resized picture for a sheet (re-drawn on a canvas, so no camera notes or GPS), one data-URL string
    //   under 950 KB; readable when the sheet is public or by its owner.
    // Deleting a document that isn't there is allowed (resource == null), so one batch can clear every copy of a sheet.
    function spOwnerOf(d) { return request.auth != null && d.uid == request.auth.uid; }
    function spBaseOk(d) {
      return d.uid is string && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.public is bool && d.created is number && d.updated is number
        && (!('story' in d) || (d.story is string && d.story.size() <= 6000))
        && (!('thumb' in d) || (d.thumb is string && d.thumb.size() <= 70000))
        && (!('ig' in d) || (d.ig is string && d.ig.size() <= 300))
        && d.lat is number && d.lon is number && d.lat >= -90 && d.lat <= 90 && d.lon >= -180 && d.lon <= 180;
    }
    function spSheetOk(d) {
      return d.keys().hasOnly(['id', 'uid', 'author', 'public', 'created', 'updated', 'title', 'story', 'lat', 'lon', 'heading', 'posture', 'height',
          'camera', 'lens', 'focal', 'sensor', 'aperture', 'shutter', 'iso', 'ev', 'filters', 'support', 'light', 'taken', 'ig', 'thumb', 'w', 'h', 'place', 'distance'])
        && spBaseOk(d)
        && (!('author' in d) || (d.author is string && d.author.size() <= 80));
    }
    // A tenth of a degree: whole numbers pass, and so does anything that is already rounded to one decimal place.
    function spArea(v) { return v is int || v == math.round(v * 10) / 10.0; }
    function spFeedOk(d) {
      return d.keys().hasOnly(['id', 'uid', 'public', 'created', 'updated', 'title', 'story', 'lat', 'lon', 'heading', 'posture', 'height',
          'camera', 'lens', 'focal', 'sensor', 'aperture', 'shutter', 'iso', 'ev', 'filters', 'support', 'light', 'taken', 'ig', 'thumb', 'w', 'h', 'distance'])
        && spBaseOk(d) && d.public == true && spArea(d.lat) && spArea(d.lon);
    }
    match /sp_sheets/{id} {
      allow read: if spOwnerOf(resource.data);
      allow create: if spOwnerOf(request.resource.data) && request.resource.data.id == id && spSheetOk(request.resource.data);
      allow update: if spOwnerOf(resource.data) && spOwnerOf(request.resource.data) && request.resource.data.id == id && spSheetOk(request.resource.data);
      allow delete: if resource == null || spOwnerOf(resource.data);
    }
    match /sp_feed/{id} {
      allow read: if true;
      allow create: if spOwnerOf(request.resource.data) && request.resource.data.id == id && spFeedOk(request.resource.data);
      allow update: if spOwnerOf(resource.data) && spOwnerOf(request.resource.data) && request.resource.data.id == id && spFeedOk(request.resource.data);
      allow delete: if resource == null || spOwnerOf(resource.data);
    }
    match /sp_public/{id} {
      allow read: if spOwnerOf(resource.data);
      allow create, update: if false;
      allow delete: if resource == null || spOwnerOf(resource.data);
    }
    match /sp_images/{id} {
      allow read: if resource.data.public == true || spOwnerOf(resource.data);
      allow create, update: if spOwnerOf(request.resource.data) && (resource == null || spOwnerOf(resource.data))
        && request.resource.data.keys().hasOnly(['uid', 'public', 'data', 'updated'])
        && request.resource.data.public is bool
        && (!('data' in request.resource.data) || (request.resource.data.data is string && request.resource.data.data.size() <= 950000));
      allow delete: if resource == null || spOwnerOf(resource.data);
    }
    // ---------- Get Ready (apps/getready): optional cloud backup of one person's checklist ----------
    // One document per signed-in Google account, readable and writable only by that account: the lists,
    // check marks and streak history as one JSON string, plus the ids of items that have a picture.
    // Pictures (small JPEGs as text) sit one per item under photos/.
    match /gr_users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updated', 'pids'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 400000
        && (!('pids' in request.resource.data) || (request.resource.data.pids is list && request.resource.data.pids.size() <= 200));
      match /photos/{pid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['img', 'updated'])
          && request.resource.data.img is string && request.resource.data.img.size() <= 600000;
      }
    }
    // ---------- Read 20 family link: one shared log for two homes ----------
    // The document id is a long random code that only people given the family link know. Any Google sign-in can
    // get, create or update the one document it knows the id of; nobody can list them, and nothing can be deleted
    // (erasing writes an empty log). Anonymous sessions are excluded.
    match /r20_shared/{key} {
      allow get: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && key.matches('[a-z2-7]{20}');
      allow create, update: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && key.matches('[a-z2-7]{20}')
        && request.resource.data.keys().hasOnly(['log', 'updated'])
        && request.resource.data.log is string && request.resource.data.log.size() <= 900000;
    }
    // ---------- Catch Log (apps/catchlog): one fishing crew per long random code ----------
    // The document id is a long random code that only people given the crew link know. Any Google sign-in can
    // get, create or update the one crew it knows the id of; nobody can list crews, and crews can't be deleted.
    // The crew's anglers, tackle, trips and spots are one JSON string; each photo is its own small document.
    // Anonymous sessions are excluded, like the Read 20 family link.
    function clCrew(code) {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && code.matches('[a-z0-9]{20,40}');
    }
    match /cl_crews/{code} {
      allow get: if clCrew(code);
      allow list, delete: if false;
      allow create, update: if clCrew(code)
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.updated is number;
      match /photos/{pid} {
        allow get, delete: if clCrew(code);
        allow list: if false;
        allow create, update: if clCrew(code)
          && request.resource.data.keys().hasOnly(['img', 'updated'])
          && request.resource.data.img is string && request.resource.data.img.size() <= 600000;
      }
    }
    // ---------- Fairway (apps/fairway): golf tournaments, one document per long random code ----------
    // Added 2026-11-17, NOT YET PUBLISHED. Until it is, the app runs each tournament on one phone.
    // The document id is a 20-character random code that only people with the tournament's QR code or link know.
    // No sign-in: golfers scan and play. Anyone who knows the code can read the tournament and add or change scores
    // (one score is one field, so phones scoring at once don't undo each other). Nobody can list tournaments or delete one.
    // The shape is checked here, the course can't change after the start, and the app re-checks every score it reads.
    // A tournament holds first and last names of the golfers who typed them in, and nothing else about them.
    // Closest to the pin: ctph lists the marked holes and ctp holds each measured distance (feet), both in the document.
    // A proof photo is its own small document under ctp/, one resized JPEG as text, readable with the code like the rest.
    // Phase 1 (also not yet published): rally (who's in before it's official), fmt (format), teams, dr (the draft),
    // m (matchups), pk (who-wins picks) and tt (tee times) ride in the same document, each with a size cap.
    // The chat is its own small documents under chat/: anyone with the code can read and post; a poll's votes and
    // the app's own birdie shouts are the only things that can change after posting, and nothing can be deleted.
    function fwOk(d) {
      return d.keys().hasOnly(['v', 'name', 'created', 'updated', 'rounds', 'cur', 'done', 'course', 'p', 'ctph', 'ctp',
          'rally', 'fmt', 'teams', 'dr', 'm', 'pk', 'tt', 'bg'])
        && d.v == 1 && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.created is number && d.updated is number
        && d.rounds is int && d.rounds >= 1 && d.rounds <= 4
        && d.cur is int && d.cur >= 1 && d.cur <= d.rounds
        && d.done is bool
        && d.course is map && d.course.keys().hasOnly(['id', 'name', 'tees', 'holes'])
        && d.course.name is string && d.course.name.size() > 0 && d.course.name.size() <= 60
        && d.course.tees is list && d.course.tees.size() >= 1 && d.course.tees.size() <= 6
        && d.course.holes is list && (d.course.holes.size() == 9 || d.course.holes.size() == 18)
        && d.p is map && d.p.size() <= 120
        && (!('ctph' in d) || (d.ctph is list && d.ctph.size() <= 18))
        && (!('ctp' in d) || (d.ctp is map && d.ctp.size() <= 72))
        && (!('rally' in d) || (d.rally is map && d.rally.keys().hasOnly(['on', 'date', 'note', 'goal', 'r'])
            && (!('r' in d.rally) || (d.rally.r is map && d.rally.r.size() <= 120))))
        && (!('fmt' in d) || (d.fmt is map && d.fmt.keys().hasOnly(['kind', 'nt', 'draft', 'clk', 'mt'])))
        && (!('teams' in d) || (d.teams is map && d.teams.size() <= 8))
        && (!('dr' in d) || (d.dr is map && d.dr.keys().hasOnly(['on', 'done', 'ord', 'pk', 'at'])
            && (!('ord' in d.dr) || (d.dr.ord is list && d.dr.ord.size() <= 8))
            && (!('pk' in d.dr) || (d.dr.pk is list && d.dr.pk.size() <= 120))))
        && (!('m' in d) || (d.m is map && d.m.size() <= 60))
        && (!('pk' in d) || (d.pk is map && d.pk.size() <= 120))
        && (!('tt' in d) || (d.tt is map && d.tt.keys().hasOnly(['date', 'where', 'g'])
            && (!('g' in d.tt) || (d.tt.g is map && d.tt.g.size() <= 60))))
        && (!('bg' in d) || (d.bg is map && d.bg.size() <= 120));
    }
    function fwMsg(d) {
      return d.keys().hasOnly(['k', 'n', 't', 'at', 'by', 'o', 'v'])
        && d.k in ['m', 'a', 'p'] && d.n is string && d.n.size() > 0 && d.n.size() <= 30
        && d.t is string && d.t.size() <= 500 && d.at is number
        && (!('by' in d) || (d.by is string && d.by.matches('[a-z0-9]{6,16}')))
        && ((d.k == 'p' && d.o is list && d.o.size() >= 2 && d.o.size() <= 6 && d.v is map && d.v.size() <= 120)
            || (d.k != 'p' && d.t.size() > 0 && !('o' in d) && !('v' in d)));
    }
    match /golf_events/{code} {
      allow get: if code.matches('[a-z2-7]{20}');
      allow list, delete: if false;
      allow create: if code.matches('[a-z2-7]{20}') && fwOk(request.resource.data);
      allow update: if code.matches('[a-z2-7]{20}') && fwOk(request.resource.data)
        && request.resource.data.created == resource.data.created
        && request.resource.data.course == resource.data.course;
      match /ctp/{id} {
        allow get: if code.matches('[a-z2-7]{20}');
        allow list, delete: if false;
        allow create, update: if code.matches('[a-z2-7]{20}') && id.matches('[a-z0-9]{6,16}')
          && exists(/databases/$(database)/documents/golf_events/$(code))
          && request.resource.data.keys().hasOnly(['img', 'updated'])
          && request.resource.data.updated is number
          && request.resource.data.img is string && request.resource.data.img.size() <= 600000
          && request.resource.data.img.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
      }
      match /chat/{id} {
        allow get, list: if code.matches('[a-z2-7]{20}');
        allow delete: if false;
        allow create: if code.matches('[a-z2-7]{20}') && id.matches('[a-z0-9]{8,32}')
          && exists(/databases/$(database)/documents/golf_events/$(code))
          && fwMsg(request.resource.data);
        allow update: if code.matches('[a-z2-7]{20}') && fwMsg(request.resource.data)
          && ((resource.data.k == 'p' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v']))
              || (resource.data.k == 'a' && request.resource.data.k == 'a'));
      }
    }
    match /gp_weeks/{key} {
      allow read, write: if gpPlayer();
    }
    // ---------- Watch link (watchlink.js, watch/family): one phone's family apps and its Wear OS watch ----------
    // One document per linked phone and watch. The id is a 26-character random code only that phone and watch know: no
    // sign-in (a watch can't do a Google sign-in), nobody can list the links, nothing can be deleted. Each app's part is
    // one JSON string; the watch writes only "w", its log of ticks, solves, reading sessions and reps.
    function fwText(d, f, n) { return !(f in d) || (d[f] is string && d[f].size() <= n); }
    match /fw_links/{key} {
      allow get: if key.matches('[a-z2-7]{26}');
      allow list, delete: if false;
      allow create, update: if key.matches('[a-z2-7]{26}')
        && request.resource.data.keys().hasOnly(['gr', 'cc', 'r20', 'pp', 'gp', 'sc', 'w', 'updated'])
        && fwText(request.resource.data, 'gr', 400000) && fwText(request.resource.data, 'w', 200000)
        && fwText(request.resource.data, 'cc', 20000) && fwText(request.resource.data, 'r20', 20000)
        && fwText(request.resource.data, 'pp', 40000) && fwText(request.resource.data, 'gp', 20000)
        && fwText(request.resource.data, 'sc', 40000)
        && (!('updated' in request.resource.data) || request.resource.data.updated is timestamp);
    }
    // Linking: the watch shows an 8-letter code; the phone leaves its link code under it for a minute or two, the watch
    // reads it and deletes it. A note can't be changed or listed, only created once, read and removed.
    match /fw_pair/{code} {
      allow get, delete: if code.matches('[a-z2-7]{8}');
      allow list, update: if false;
      allow create: if code.matches('[a-z2-7]{8}')
        && request.resource.data.keys().hasOnly(['k', 'at'])
        && request.resource.data.k is string && request.resource.data.k.matches('[a-z2-7]{26}')
        && request.resource.data.at is timestamp;
    }
    // ---------- App numbers: anonymous counts sent by install.js (read on toolbox/numbers.html) ----------
    // One document per phone per app (installs) or per phone per app per week (opens). The id is
    // app~phone or app~week~phone, and a phone is a random 16-character code: no names, accounts or content.
    // Anyone may create one; only the owner (the rule at the top) can read, change or delete them.
    function countOk(id, n) {
      return request.resource.data.keys().hasOnly(['app', 'week'])
        && request.resource.data.app is string && request.resource.data.app.matches('[A-Za-z0-9-]{1,60}')
        && request.resource.data.week is string && request.resource.data.week.matches('20[0-9]{2}-W[0-9]{2}')
        && id.split('~').size() == n && id.split('~')[0] == request.resource.data.app
        && id.split('~')[n - 1].matches('[a-z0-9]{16}');
    }
    match /app_installs/{id} {
      allow create: if countOk(id, 2);
    }
    match /app_opens/{id} {
      allow create: if countOk(id, 3) && id.split('~')[1] == request.resource.data.week;
    }
    // Same again for "someone actually read" (app_reads) and "someone met the goal" (app_goals), once per phone per app per week.
    match /app_reads/{id} {
      allow create: if countOk(id, 3) && id.split('~')[1] == request.resource.data.week;
    }
    match /app_goals/{id} {
      allow create: if countOk(id, 3) && id.split('~')[1] == request.resource.data.week;
    }
    // "This is me" (toolbox/me.html): a browser the owner marked sends its random phone code once, so the numbers page can
    // leave out what it counted before. Only the app's folder is stored. Anyone may create one; only the owner reads them.
    match /app_me/{pid} {
      allow create: if pid.matches('[a-z0-9]{16}') && request.resource.data.keys().hasOnly(['app'])
        && request.resource.data.app is string && request.resource.data.app.matches('[A-Za-z0-9-]{1,60}');
    }
  }
}
