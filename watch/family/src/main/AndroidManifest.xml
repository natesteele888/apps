<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Google's watch-face and tile libraries say Android 8; only Next up and the Schedule tile use them, and both are switched off before Android 8 (@bool/face_on) -->
    <uses-sdk tools:overrideLibrary="androidx.wear.tiles, androidx.wear.protolayout, androidx.wear.protolayout.expression, androidx.wear.protolayout.expression.pipeline, androidx.wear.protolayout.proto, androidx.wear.protolayout.renderer, androidx.wear.watchface.complications.datasource, androidx.wear.watchface.complications.datasource.ktx, androidx.wear.watchface.complications.data, androidx.wear.watchface.complications, androidx.wear.watchface.data, androidx.wear.watchface.utility, androidx.wear.watchface.style, androidx.wear.watchface.client, androidx.wear.watchface" />
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Practice Clock buzzes at every block change with the screen off: an exact alarm for each change -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- everything goes through the watch link on the internet (through the phone on watches without Wi-Fi or LTE) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Fairway's yards to the green, from the watch's own GPS, only while Fairway is on screen; asked for the first time it's needed -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Fairway's Jack and Sal listen with the watch's speech input and talk with its voice; Sal also
         uses the watch's keyboard (Android 11+ needs to see them) -->
    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <intent><action android:name="android.support.wearable.input.action.REMOTE_INPUT" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <!-- One install, several apps in the watch's app list. Each works without the others; one link to the phone covers them all. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_getready"
        android:roundIcon="@mipmap/ic_getready"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Family">
        <!-- needs no phone app: it talks to the phone's web apps through the watch link -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <activity android:name=".GetReadyActivity" android:exported="true" android:icon="@mipmap/ic_getready" android:roundIcon="@mipmap/ic_getready"
            android:label="@string/getready_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.getready">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".CubeActivity" android:exported="true" android:icon="@mipmap/ic_cube" android:roundIcon="@mipmap/ic_cube"
            android:label="@string/cube_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.cube">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".PowerActivity" android:exported="true" android:icon="@mipmap/ic_power" android:roundIcon="@mipmap/ic_power"
            android:label="@string/power_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.power">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".PicksActivity" android:exported="true" android:icon="@mipmap/ic_picks" android:roundIcon="@mipmap/ic_picks"
            android:label="@string/picks_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.picks">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".ReadActivity" android:exported="true" android:icon="@mipmap/ic_read" android:roundIcon="@mipmap/ic_read"
            android:label="@string/read_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.read">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".PracticeActivity" android:exported="true" android:icon="@mipmap/ic_practice" android:roundIcon="@mipmap/ic_practice"
            android:label="@string/practice_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.practice">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <!-- wakes at each block change of a running practice to buzz (only this app's own alarms reach it) -->
        <receiver android:name=".PracticeBuzzReceiver" android:exported="false" />
        <!-- Sal needs no link to the phone. It opens straight into listening, so a watch button set to open it is the hot button. -->
        <activity android:name=".SpellActivity" android:exported="true" android:icon="@mipmap/ic_spell" android:roundIcon="@mipmap/ic_spell"
            android:label="@string/spell_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.spell">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".ScheduleActivity" android:exported="true" android:icon="@mipmap/ic_schedule" android:roundIcon="@mipmap/ic_schedule"
            android:label="@string/schedule_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.schedule">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".StatsActivity" android:exported="true" android:icon="@mipmap/ic_stats" android:roundIcon="@mipmap/ic_stats"
            android:label="@string/stats_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.stats">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <!-- Next up on the watch face (long-press the face › Customize › tap a slot › Steele Family › Next up): the next game or
             practice from Schedule. Android 8+ only: @bool/face_on switches it off before that, which tools:targetApi tells lint. -->
        <service
            android:name=".NextUpComplication"
            android:enabled="@bool/face_on"
            tools:targetApi="26"
            android:exported="true"
            android:icon="@drawable/ic_face_next"
            android:label="@string/face_next_name"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT" />
            <!-- every 30 minutes; a new schedule from the phone asks straight away (Link) -->
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="1800" />
        </service>
        <!-- the Schedule tile (swipe from the watch face): the next game or practice and the two after it. Off before Android 8. -->
        <service
            android:name=".ScheduleTileService"
            android:exported="true"
            android:enabled="@bool/face_on"
            android:icon="@mipmap/ic_schedule"
            android:label="@string/schedule_name"
            android:description="@string/schedule_tile_about"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_schedule_preview" />
        </service>
        <activity android:name=".FairwayActivity" android:exported="true" android:icon="@mipmap/ic_fairway" android:roundIcon="@mipmap/ic_fairway"
            android:label="@string/fairway_name" android:launchMode="singleTask" android:taskAffinity="com.steele.family.fairway">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
