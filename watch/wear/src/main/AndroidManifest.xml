<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The tile libraries ask for Android 8 (Wear OS 2). The app still installs on Android Wear 2.0 (Android 7.1):
         there the tile services and Live score stay off (res/values/bools.xml) and nothing calls their code. -->
    <uses-sdk tools:overrideLibrary="androidx.wear.tiles, androidx.wear.protolayout, androidx.wear.protolayout.expression, androidx.wear.protolayout.expression.pipeline, androidx.wear.protolayout.proto, androidx.wear.watchface.complications.datasource, androidx.wear.watchface.complications.datasource.ktx, androidx.wear.watchface.complications.data, androidx.wear.watchface.complications, androidx.wear.watchface.data, androidx.wear.watchface.utility, androidx.wear.protolayout.renderer, androidx.wear.watchface.style, androidx.wear.watchface.client, androidx.wear.watchface, androidx.wear.ongoing" />
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Wear OS 4 and up: the icon on the watch face that leads back to Walk-Up or Pitch Count (Ongoing.kt) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- GC Scores and Scores read scores over the internet (through the phone on watches without Wi-Fi or LTE) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- One install, four apps in the watch's app list: Walk-Up, Pitch Count, Scores and GC Scores. Each works without the others. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Dugout">
        <!-- works with the phone app; Pitch Count also counts with no phone nearby and syncs later -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />
        <activity
            android:name=".WalkUpActivity"
            android:exported="true"
            android:icon="@mipmap/ic_walkup"
            android:roundIcon="@mipmap/ic_walkup"
            android:label="@string/walkup_name"
            android:launchMode="singleTask"
            android:taskAffinity="com.steele.dugout.walkup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PitchCountActivity"
            android:exported="true"
            android:icon="@mipmap/ic_pitch"
            android:roundIcon="@mipmap/ic_pitch"
            android:label="@string/pitch_name"
            android:launchMode="singleTask"
            android:taskAffinity="com.steele.dugout.pitch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ScoresActivity"
            android:exported="true"
            android:icon="@mipmap/ic_scores"
            android:roundIcon="@mipmap/ic_scores"
            android:label="@string/scores_name"
            android:launchMode="singleTask"
            android:taskAffinity="com.steele.dugout.scores">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GameChangerActivity"
            android:exported="true"
            android:icon="@mipmap/ic_gc"
            android:roundIcon="@mipmap/ic_gc"
            android:label="@string/gc_name"
            android:launchMode="singleTask"
            android:taskAffinity="com.steele.dugout.gc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tiles (swipe from the watch face): Pitch Count with +1 and Undo on the tile, a Walk-Up Stop, and today's league Scores -->
        <service
            android:name=".PitchTileService"
            android:exported="true"
            android:enabled="@bool/tiles_on"
            android:icon="@mipmap/ic_pitch"
            android:label="@string/pitch_name"
            android:description="@string/pitch_tile_about"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_pitch_preview" />
        </service>
        <service
            android:name=".WalkUpTileService"
            android:exported="true"
            android:enabled="@bool/tiles_on"
            android:icon="@mipmap/ic_walkup"
            android:label="@string/walkup_name"
            android:description="@string/walkup_tile_about"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_walkup_preview" />
        </service>
        <service
            android:name=".ScoresTileService"
            android:exported="true"
            android:enabled="@bool/tiles_on"
            android:icon="@mipmap/ic_scores"
            android:label="@string/scores_name"
            android:description="@string/scores_tile_about"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_scores_preview" />
        </service>

        <!-- the pitch count on the watch face: pick Pitch Count for a slot on any watch face that has them -->
        <service
            android:name=".PitchComplicationService"
            android:exported="true"
            android:enabled="@bool/tiles_on"
            android:icon="@drawable/ic_pitch_fg"
            android:label="@string/pitch_name"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,RANGED_VALUE,LONG_TEXT" />
            <!-- every pitch asks the face to update at once; the half-hourly look only starts a new day at 0 -->
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="1800" />
        </service>

        <!-- the phone's pitch log, taken even with Pitch Count closed, so the tile matches the phone -->
        <service android:name=".PitchSyncService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/pitch/log" />
            </intent-filter>
        </service>
        <!-- Live score on the watch face (long-press the face › Customize › tap a slot › Dugout › Live score): GC Scores' team. Android 8+ only: @bool/face_on switches it off before that, which tools:targetApi tells lint. -->
        <service
            android:name=".GcScoreComplication"
            android:enabled="@bool/face_on"
            tools:targetApi="26"
            android:exported="true"
            android:icon="@drawable/ic_face_gc"
            android:label="@string/face_score_name"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT" />
            <!-- every 5 minutes, the least the watch allows; during a game GcScoreComplication asks every minute itself -->
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300" />
        </service>
        <!-- the minute alarm during a game -->
        <receiver android:name=".GcScoreTick" android:enabled="@bool/face_on" android:exported="false" />
        <!-- a new GameChanger team from the phone updates the watch face even with GC Scores closed -->
        <service android:name=".GcTeamListener" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/gc/team" />
            </intent-filter>
        </service>
    </application>
</manifest>
