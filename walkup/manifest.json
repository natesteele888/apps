{
  "name": "Walk-Up — Your Walk-Up Music Studio",
  "short_name": "Walk-Up",
  "description": "Record each player's announcement, polish it, add the songs they pick, balance voice and music, and play it on cue. Everything stays on your phone.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A0D12",
  "theme_color": "#0A0D12",
  "icons": [
    {
      "src": "/apps/icons/walkup-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apps/icons/walkup-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apps/icons/walkup-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "songs",
          "accept": [
            "audio/*",
            ".mp3",
            ".wav",
            ".wave",
            ".m4a",
            ".aac",
            ".mp4",
            ".ogg",
            ".oga",
            ".opus",
            ".flac",
            ".aif",
            ".aiff",
            ".caf",
            ".webm",
            ".3gp",
            ".amr"
          ]
        }
      ]
    }
  }
}
